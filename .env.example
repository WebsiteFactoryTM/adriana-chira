# ==============================================================================
# adrianachira.ro — variabile de mediu
# Copiază în `.env.local` pentru dezvoltare. În producție se setează în Vercel,
# separat pentru Production și pentru Preview.
# ==============================================================================

# --- Aplicație ----------------------------------------------------------------
# URL-ul canonic, fără slash final. Alimentează metadataBase, canonical, OG,
# sitemap, robots și llms.txt. În Preview, pune URL-ul de preview.
NEXT_PUBLIC_SITE_URL=https://adrianachira.ro

# --- Analytics ----------------------------------------------------------------
# ID-ul de măsurare GA4 (G-XXXXXXXXXX).
# TEMPORAR aici: la faza 2 se mută în globalul Payload `site-settings`, ca
# Adriana să îl poată schimba singură, fără redeploy. Dacă lipsește, GA4 nu se
# încarcă niciodată — comportament intenționat.
NEXT_PUBLIC_GA4_ID=

# ==============================================================================
# URMĂTOARELE NU SUNT ÎNCĂ FOLOSITE — intră odată cu fazele 2 și 4.
# Le păstrăm aici ca lista de credențiale de cerut clientei să fie completă.
# ==============================================================================

# --- Payload + baza de date (faza 2) ------------------------------------------
# Șir aleatoriu lung. Se generează cu: openssl rand -base64 32
PAYLOAD_SECRET=
# Postgres — OBLIGATORIU connection string POOLED (Neon sau Vercel Postgres).
# Un string nepooled epuizează conexiunile în serverless.
DATABASE_URI=
# Vercel Blob, pentru fișierele încărcate în admin.
BLOB_READ_WRITE_TOKEN=

# --- Stripe (faza 4) ----------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Din `stripe listen` în local, din dashboard în producție.
STRIPE_WEBHOOK_SECRET=

# --- Email (faza 4) -----------------------------------------------------------
RESEND_API_KEY=
# Domeniu verificat în Resend, altfel emailurile ajung în spam.
EMAIL_FROM=contact@adrianachira.ro
EMAIL_TO_ADMIN=

# --- Revalidare la publicare (faza 2) -----------------------------------------
# Protejează /api/revalidate. Șir aleatoriu.
REVALIDATE_SECRET=
