# ==============================================================================
# adrianachira.ro — variabile de mediu
# Copiază în `.env.local` pentru dezvoltare. În producție se setează în Vercel,
# separat pentru Production și pentru Preview.
# ==============================================================================

# --- Aplicație ----------------------------------------------------------------
# URL-ul canonic, fără slash final. Alimentează metadataBase, canonical, OG,
# sitemap, robots și llms.txt. În Preview, pune URL-ul de preview.
NEXT_PUBLIC_SITE_URL=https://adrianachira.ro

# --- Analytics ----------------------------------------------------------------
# ID-ul de măsurare GA4 (G-XXXXXXXXXX).
# ÎNLOCUIT de globalul Payload `site-settings`, pe care Adriana îl poate edita
# singură, fără redeploy. Variabila rămâne doar ca rezervă: valoarea din CMS are
# întâietate. Dacă niciuna nu e completată, GA4 nu se încarcă — intenționat.
NEXT_PUBLIC_GA4_ID=

# --- Payload + baza de date ---------------------------------------------------
# Șir aleatoriu lung. Se generează cu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYLOAD_SECRET=
# Postgres. În PRODUCȚIE, obligatoriu connection string POOLED (Neon sau Vercel
# Postgres) — unul nepooled epuizează conexiunile în serverless.
# LOCAL, baza de date rulează în Docker (`pnpm db:up`, vezi docker-compose.yml):
#   DATABASE_URI=postgres://adriana:adriana_local@127.0.0.1:5432/adriana_chira
DATABASE_URI=
# Vercel Blob, pentru fișierele încărcate în admin. Dacă lipsește, fișierele se
# salvează pe disc, în public/media/ — suficient local, nefolosibil în producție
# (filesystem-ul Vercel e efemer).
BLOB_READ_WRITE_TOKEN=

# Cont de administrator creat de `pnpm seed`, la prima rulare. Fără ele, seed-ul
# generează o parolă aleatoare și o afișează o singură dată.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ==============================================================================
# PLĂȚI ȘI EMAIL — folosite din septembrie 2026.
# Fără ele site-ul funcționează, dar NU încasează: butonul de plată trimite
# cumpărătorul pe pagina de contact, cu produsul precompletat în mesaj. Este o
# degradare intenționată, nu o eroare — vezi src/app/api/stripe/checkout/route.ts
# ==============================================================================

# --- Stripe -------------------------------------------------------------------
# Toate prețurile sunt în LEI (RON). La salvarea unui pachet sau workshop în
# admin, prețul se creează automat în Stripe. Fără cheie, documentul se salvează
# oricum și rămâne marcat „Nesincronizat".
STRIPE_SECRET_KEY=
# NEFOLOSIT: checkout-ul se face printr-un `<form method="post">` către
# /api/stripe/checkout, care redirectează spre Stripe pe server. Nu există
# Stripe.js în pagină, deci nici cheie publicabilă. Rămâne aici doar ca să nu
# fie căutată degeaba.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# OBLIGATORIU pentru ca plățile să ajungă în colecția Comenzi. Fără el,
# webhook-ul răspunde 503 și refuză să scrie ceva ce nu poate verifica.
# Local: din `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Producție: din dashboard, la endpointul creat pe /api/stripe/webhook
# Evenimente de abonat: checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=
# Domeniu verificat în Resend, altfel emailurile ajung în spam.
EMAIL_FROM=contact@adrianachira.ro
# Unde ajunge notificarea de comandă nouă. Gol = doar clientul primește email.
EMAIL_TO_ADMIN=

# --- Revalidare la publicare --------------------------------------------------
# NEFOLOSIT deocamdată. Payload rulează în același proces cu Next, deci
# invalidarea se face direct din hook-uri (src/hooks/revalidate.ts), fără rută
# HTTP. Variabila rămâne aici pentru cazul în care CMS-ul se mută pe alt host.
REVALIDATE_SECRET=
